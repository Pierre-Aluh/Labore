# Environment name: development | homologation | production
LABORE_ENV=development

# API settings (placeholders only)
LABORE_API_HOST=127.0.0.1
LABORE_API_PORT=8000
LABORE_API_LOG_LEVEL=INFO

# PostgreSQL settings for local Compose only; replace locally, never commit secrets
POSTGRES_DB=labore
POSTGRES_USER=labore_app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Storage paths are placeholders for future phases
LABORE_STORAGE_ROOT=./storage/clientes
LABORE_BACKUP_ROOT=./backup

# Cloudflare Tunnel is intentionally unconfigured in Phase 01
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=
